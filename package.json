{
  "name": "matt-portfolio-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "sync-photos": "node scripts/sync-google-photos.js",
    "sync-photos:deploy": "node scripts/sync-google-photos.js --deploy",
    "watch-photos": "node scripts/watch-drive-folder.js",
    "approve-photos": "node scripts/approve-and-deploy.js",
    "reject-photos": "node scripts/reject-project.js",
    "test-notify": "node scripts/notify-phone.js --test",
    "scan-photos": "node scripts/ai-photo-scanner.js",
    "scan-album": "node scripts/ai-photo-scanner.js --url",
    "watch-album": "node scripts/watch-google-album.js",
    "sync-album": "node scripts/watch-google-album.js --once",
    "publish": "git add -A && git commit -m \"Update site content $(date +'%Y-%m-%d %H:%M')\" && git push origin main",
    "deploy": "npm run publish"
  },
  "dependencies": {
    "@emailjs/browser": "^3.11.0",
    "@react-three/drei": "^9.88.2",
    "@react-three/fiber": "^8.14.5",
    "dotenv": "^16.3.1",
    "framer-motion": "^10.16.4",
    "maath": "^0.10.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "react-tilt": "^1.0.2",
    "react-vertical-timeline-component": "^3.6.0",
    "three": "^0.163.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "vite": "^5.4.21"
  }
}
